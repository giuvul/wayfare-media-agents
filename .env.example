# Configurazione di Wayfare Media Agents.
# Copia questo file in `.env` (escluso da git) e inserisci i tuoi valori.
# Lo leggono sia il back end (Node) sia il data agent (Python). Le variabili d'ambiente già impostate,
# ad esempio da docker compose, hanno la precedenza sul file.

# --- Modello linguistico (OpenRouter, API compatibile OpenAI) ---------------------------------
# Va inserita una API key di OpenRouter (https://openrouter.ai/keys), qui o dalle Impostazioni dell'app.
# Con il BYOK di OpenRouter le chiamate ai modelli di un fornitore possono usare una sua chiave già esistente.
# La usa solo il back end: il data agent chiama il modello attraverso il proxy del back end (/internal/llm).
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5
# modelli di riserva, usati da OpenRouter se il principale non risponde (separati da virgole)
LLM_FALLBACK_MODELS=deepseek/deepseek-v4.1-flash
# LLM_TIMEOUT_MS=45000          # back end, per singola chiamata al modello
# LLM_TIMEOUT_S=45              # data agent, per singola chiamata al modello

# --- Embedding (ricerca nella documentazione) -----------------------------------------------
# openrouter = calcolati da OpenRouter; local = calcolati sul server (vedi il catalogo in backend/src/embeddings)
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Xenova/multilingual-e5-small
# MODELS_DIR=./storage/models   # dove vengono scaricati i modelli locali

# --- Comunicazione back end -> data agent -----------------------------------------------------
# segreto condiviso (header X-Internal-Token), almeno 16 caratteri: back end e data agent non partono senza.
# Generalo con: openssl rand -hex 32
DATA_AGENT_TOKEN=
# DATA_AGENT_URL=http://localhost:8001
# DATA_AGENT_TIMEOUT_MS=75000

# --- Knowledge base (ChromaDB) -----------------------------------------------------------------
# CHROMA_URL=http://localhost:8000
# CHROMA_COLLECTION=wayfare_handbook
# KB_DIR=./data/kb
# RAG_TOP_K=5
# soglia per il modello del .env; i modelli scelti dall'interfaccia usano una soglia calibrata
# RAG_MIN_SIMILARITY=0.2

# --- Back end -----------------------------------------------------------------------------------
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=3001
# FRONTEND_ORIGIN=http://localhost:5173

# --- Front end in sviluppo (npm run dev) ----------------------------------------------------------
# FRONTEND_HOST=127.0.0.1
# FRONTEND_PORT=5173
# BACKEND_URL=http://localhost:3001   # dove il server di sviluppo inoltra /api
# TRUST_PROXY=0                 # proxy fidati davanti al back end (docker compose lo imposta a 1 per nginx)
# STORAGE_DIR=./storage         # cronologia, impostazioni e memoria dell'agente (SQLite)
# CHAT_TIMEOUT_MS=120000
# CHAT_RATE_LIMIT_PER_MIN=20
# AGENT_MAX_MODEL_CALLS=6
# LOG_LEVEL=info

# --- Data agent ---------------------------------------------------------------------------------
# LLM_PROXY_URL=http://localhost:3001/internal/llm   # proxy del back end verso il modello (token interno)
# DATA_CSV_PATH=./data/campagne_wayfare.csv
# DATA_DICTIONARY_PATH=./data/dizionario_dati.md
# EXEC_TIMEOUT_S=15             # singola esecuzione di codice nella sandbox
# REQUEST_TIMEOUT_S=60          # intera analisi
# MAX_AGENT_STEPS=10
# MAX_CONCURRENT_ANALYSES=2
# CLEANING_MAX_ATTEMPTS=3
